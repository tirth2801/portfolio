---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBar from '../components/os/StatusBar.astro';
import DockNav from '../components/os/DockNav.astro';
import CompanionWidget from '../components/os/CompanionWidget.astro';
import BootOverlay from '../components/os/BootOverlay.astro';
import GlitchOverlay from '../components/os/GlitchOverlay.astro';
import Home from '../components/os/screens/Home.astro';
import About from '../components/os/screens/About.astro';
import Skills from '../components/os/screens/Skills.astro';
import Projects from '../components/os/screens/Projects.astro';
import Work from '../components/os/screens/Work.astro';
import Education from '../components/os/screens/Education.astro';
import Contact from '../components/os/screens/Contact.astro';
---

<BaseLayout>
  <div class="os-shell">
    <div class="os-glow"></div>
    <StatusBar />
    <DockNav />
    <div class="os-viewport">
      <Home />
      <About />
      <Skills />
      <Projects />
      <Work />
      <Education />
      <Contact />
    </div>
    <CompanionWidget />
    <GlitchOverlay />
    <BootOverlay />
  </div>
</BaseLayout>
