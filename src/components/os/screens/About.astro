---
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../../../data/site';

const base = import.meta.env.BASE_URL;
const { about, social } = site;
const avatarPath = path.join(process.cwd(), 'public/images', about.image);
const hasAvatar = fs.existsSync(avatarPath);
---

<div class="os-screen" data-screen="about" hidden>
  <div class="about-grid">
    <div>
      <div class="eyebrow mono"><span class="eyebrow-pink">// ABOUT.EXE</span></div>
      <h2 class="about-heading">Field engineer.<br /><span class="about-heading-muted">Full-stack builder.</span></h2>
      <div class="about-bio">
        {about.bioParagraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="about-links mono">
        <a target="_blank" rel="noopener" href={social.github}>GITHUB ↗</a>
        <a target="_blank" rel="noopener" href={social.linkedin}>LINKEDIN ↗</a>
      </div>
    </div>
    {hasAvatar && (
      <div class="avatar-frame">
        <img class="avatar-frame-img" src={`${base}images/${about.image}`} alt="Tirth avatar" />
      </div>
    )}
  </div>
</div>
