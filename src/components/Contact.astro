---
import { site } from '../data/site';

const { social, copyrightYear } = site;
---

<footer id="contact" class="section-alt">
  <h2>Contact</h2>
  <p class="section-eyebrow">Open to new opportunities — let's talk</p>
  <hr />

  <h3>Let's connect</h3>

  <div class="socials">
    <a target="_blank" rel="noopener" href={social.github}><i class="social fab fa-github"></i></a>
    <a target="_blank" rel="noopener" href={social.linkedin}><i class="social fab fa-linkedin"></i></a>
    <a target="_blank" rel="noopener" href={social.gitlab}><i class="social fab fa-gitlab"></i></a>
    <a target="_blank" rel="noopener" href={social.facebook}><i class="social fab fa-facebook"></i></a>
  </div>

  <p class="copyright">© {site.name} {copyrightYear}</p>
</footer>
