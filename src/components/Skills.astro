---
import { skillCategories } from '../data/skills';
---

<section id="skills" class="section">
  <h2>Skills</h2>
  <p class="section-eyebrow">Core toolkit, sharpened on real delivery work</p>
  <hr />

  <div class="skills-grid">
    {skillCategories.map((category, i) => (
      <div class="skill-card" data-reveal style={`transition-delay: ${i * 80}ms`}>
        <div class="skill-card-header">
          <i class={`${category.icon} skill-card-icon`}></i>
          <h3>{category.title.toUpperCase()}</h3>
        </div>

        <ul>
          {category.items.map((item) => (
            <li><i class="fas fa-check"></i> {item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
