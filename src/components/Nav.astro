---
const links = [
  { href: '#intro', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#edu', label: 'Education' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#work', label: 'Work' },
  { href: '#contact', label: 'Contact' },
];
---

<nav class="navbar">
  <div class="navbar-inner">
    <ul class="navbar-links" id="nav-links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <div class="navbar-controls">
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">
        <i class="fas fa-sun theme-icon theme-icon-light" aria-hidden="true"></i>
        <i class="fas fa-moon theme-icon theme-icon-dark" aria-hidden="true"></i>
      </button>
      <button class="navbar-toggle" id="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false" aria-label="Toggle navigation">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  links?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      links.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // keep in sync with BaseLayout.astro head script
  const KEY = 'theme';
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem(KEY, next);
    } catch {}
  });
</script>
