---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  reverse: boolean;
}

const { entry, reverse } = Astro.props;
const { title, repoUrl, liveUrl, image, icon, stack, outcome } = entry.data;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL;
---

<div class={`split ${reverse ? 'reverse' : ''}`} data-reveal>
  <div>
    <h3>{title}</h3>

    <div>
      <a target="_blank" rel="noopener" href={repoUrl} class="btn">VIEW CODE</a>
      {liveUrl && (
        <a target="_blank" rel="noopener" href={liveUrl} class="btn">VIEW LIVE</a>
      )}
    </div>

    {outcome && <p class="entry-outcome">{outcome}</p>}

    <div class="entry-write-up">
      <Content />
    </div>

    {stack?.length ? (
      <ul class="entry-stack">
        {stack.map((tech) => <li class="stack-badge">{tech}</li>)}
      </ul>
    ) : null}
  </div>

  <div class="split-media entry-media">
    {image ? (
      <img src={`${base}images/${image}`} alt={`${title} screenshot`} width="420" height="300" loading="lazy" decoding="async" />
    ) : (
      <div class="entry-icon"><i class={icon ?? 'fas fa-diagram-project'}></i></div>
    )}
  </div>
</div>
