---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="section-alt">
  <h2>Projects</h2>
  <p class="section-eyebrow">Selected projects, built end-to-end</p>
  <hr />

  <div class="entry-list">
    {projects.map((entry, i) => (
      <ProjectCard entry={entry} reverse={i % 2 === 1} />
    ))}
  </div>

  <div class="more-projects">
    <a target="_blank" rel="noopener" href={site.githubReposUrl} class="btn">VIEW GITHUB FOR MORE PROJECTS...</a>
  </div>
</section>
