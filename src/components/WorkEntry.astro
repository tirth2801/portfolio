---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  reverse: boolean;
}

const { entry, reverse } = Astro.props;
const { company, role, dates, image } = entry.data;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL;
---

<div class={`split ${reverse ? 'reverse' : ''}`}>
  <div class="split-media entry-media">
    {image ? (
      <img src={`${base}images/${image}`} alt={`${company} logo`} />
    ) : (
      <div class="entry-icon"><i class="fas fa-building"></i></div>
    )}
  </div>

  <div>
    <h3>{company}</h3>
    <h4>{role} ({dates})</h4>

    <div class="entry-write-up">
      <Content />
    </div>
  </div>
</div>
