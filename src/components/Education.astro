---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const { education, quotes } = site;
---

<section id="edu" class="section section-dark">
  <h2>Education</h2>
  <h4>"{quotes.edu.text}"</h4>
  <h5>- {quotes.edu.author}</h5>
  <hr />

  <div class="split">
    <div>
      <h4><strong>{education.school}</strong> ({education.dates})</h4>
      <p class="edu-degree">{education.degree}</p>

      <a target="_blank" rel="noopener" href={`${base}${education.resumePath}`} class="btn">MY RESUME</a>
    </div>

    <div class="split-media">
      <a target="_blank" rel="noopener" href={education.schoolUrl}>
        <img class="edu-img" src={`${base}images/${education.image}`} alt={`${education.school} Pic`} />
      </a>
    </div>
  </div>
</section>
